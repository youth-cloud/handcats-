# Only application source and repository configuration belong at the root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
!/android/
!/backend/

# Android source, tests and Gradle wrapper.
/android/*
!/android/app/
!/android/gradle/
!/android/gradlew
!/android/gradlew.bat
!/android/gradle.properties
!/android/settings.gradle.kts
!/android/build.gradle.kts
/android/app/*
!/android/app/src/
!/android/app/build.gradle.kts
!/android/app/proguard-rules.pro
# Local device journeys and screenshots are not part of CI.
/android/app/src/androidTest/

# API and automated tests, without local deployment scripts.
/backend/*
!/backend/app/
!/backend/tests/
!/backend/run.py
!/backend/requirements.txt
!/backend/requirements-dev.txt
!/backend/.env.example

# IDE, build and Python caches.
.idea/
.gradle/
.kotlin/
build/
captures/
local.properties
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage*
coverage.xml
htmlcov/
test-results/
*.log
*.tmp
.DS_Store
Thumbs.db

# Credentials and signing material.
.env
.env.*
!.env.example
*.jks
*.keystore
*.pem
*.key
key.properties
keystore.properties

# Datasets, training output, weights and exported models.
训练集/
datasets/
dataset_manifests/
deletion_manifests/
runs/
weights/
models/
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.safetensors
*.h5
*.hdf5
*.ckpt
*.cache

# Local data, archives and generated packages.
storage/
backups/
releases/
*.apk
*.aab
*.zip
*.7z
*.tar
*.gz
*.db
*.sqlite*
*.dump
*.sql
