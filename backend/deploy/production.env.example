PRODUCTION=true
DEBUG=false
REGISTRATION_ENABLED=false
DATABASE_ECHO=false
# Same-host PostgreSQL peer auth: no database password to store.
DATABASE_URL=postgresql+asyncpg://handcats@/handcats?host=/var/run/postgresql
UPLOAD_DIR=/var/lib/handcats/photos
MODEL_WEIGHTS_PATH=/opt/handcats/models/best.onnx
MODEL_IMAGE_SIZE=640
MODEL_CPU_THREADS=2
MODEL_CONFIDENCE=0.35
MODEL_IOU_THRESHOLD=0.45
# 1 executing + at most 4 waiting; this is not 5 simultaneous YOLO calls.
INFERENCE_CAPACITY=5
INFERENCE_QUEUE_SECONDS=25
REVIEW_CAPACITY=4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=45
