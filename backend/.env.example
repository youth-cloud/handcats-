APP_NAME=拾猫 API
DEBUG=false
DATABASE_URL=postgresql+asyncpg://handcats:change-me@127.0.0.1:5432/handcats
DATABASE_ECHO=false
# Absolute path to locally supplied weights; models are not included in Git.
MODEL_WEIGHTS_PATH=/absolute/path/to/cat_breed_best.pt
MODEL_CONFIDENCE=0.35
MODEL_IOU_THRESHOLD=0.45
# Optional visual review. Use the model id shown by your DeepSeek account;
# the public vision API documentation currently calls it deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=45
